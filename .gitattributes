# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows-specific files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tar binary
*.gz binary
*.zip binary
*.jar binary
*.apk binary
*.aab binary
*.so binary